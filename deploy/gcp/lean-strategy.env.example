# Copy to /etc/lean-strategy/lean-strategy.env and chmod 600.
# Keep credentials out of git and out of GitHub Actions logs.
APP_ROOT=/opt/lean-strategies
LEAN_REPO=/opt/Lean
STRATEGY_PATH=strategies/python/HelloLeanStrategy.py
ALGORITHM_TYPE_NAME=HelloLeanStrategy
STRATEGY_RUNNER=/opt/lean-strategies/scripts/run-live-ib.sh
LIVE_CONFIRM=true
IB_TRADING_MODE=paper
IB_USE_EXISTING_GATEWAY=false
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=20
IB_ACCOUNT=DU1234567
# Required for managed IB Gateway mode:
# IB_USER_NAME=
# IB_PASSWORD=
# IB_TWS_DIR=/home/lean/Jts
# IB_VERSION=1046
