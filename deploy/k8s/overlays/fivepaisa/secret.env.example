# Per-instance Secret source for secretGenerator (deploy/k8s/overlays/<broker>/secret.env).
# Copy to `secret.env`, fill in, never commit it (covered by deploy/k8s/.gitignore).
#
# Generate ONCE per instance, BEFORE the first boot, and back the values up
# (e.g. in a password manager). Why pinning is mandatory in Kubernetes:
# /app/.env lives in the ephemeral container layer, and utils/env_check.py
# auto-rotates placeholder FERNET_SALT there on first boot. An unpinned salt is
# re-rotated on EVERY pod restart, which makes the Fernet-encrypted broker
# tokens in the persistent database undecryptable.
#
# APP_KEY          -> python3 -c "import secrets; print(secrets.token_hex(32))"
# API_KEY_PEPPER   -> python3 -c "import secrets; print(secrets.token_hex(32))"
# FERNET_SALT      -> python3 -c "import secrets; print(secrets.token_hex(16))"  (>= 32 hex chars)
#
# NEVER reuse APP_KEY / API_KEY_PEPPER / FERNET_SALT across instances.
APP_KEY=
API_KEY_PEPPER=
FERNET_SALT=

# Broker credentials for THIS instance's broker account (format per broker
# documentation; several brokers use 'client_id:::api_key').
BROKER_API_KEY=
BROKER_API_SECRET=

# XTS-protocol brokers only (leave empty otherwise):
# BROKER_API_KEY_MARKET=
# BROKER_API_SECRET_MARKET=
